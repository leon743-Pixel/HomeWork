<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- ===================== ШАПКА: иконка + заголовок ===================== -->
    <ImageView
        android:id="@+id/imageViewAcIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@android:drawable/ic_menu_compass"
        android:contentDescription="Иконка кондиционера"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Кондиционер"
        android:textColor="#1A1A1A"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/imageViewAcIcon"
        app:layout_constraintBottom_toBottomOf="@id/imageViewAcIcon"
        app:layout_constraintStart_toEndOf="@id/imageViewAcIcon"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textViewSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Гостиная · Основной блок"
        android:textColor="#6B7280"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/textViewTitle"
        app:layout_constraintStart_toStartOf="@id/textViewTitle"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===================== SWITCH «ПИТАНИЕ» ===================== -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchPower"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Питание"
        android:textSize="18sp"
        android:checked="true"
        app:layout_constraintTop_toBottomOf="@id/imageViewAcIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===================== CARDVIEW: ТЕМПЕРАТУРА ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTemperature"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/switchPower"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:id="@+id/textViewTempLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Целевая температура"
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textViewTemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="+22°C"
                android:textColor="#1A1A1A"
                android:textSize="48sp"
                android:textStyle="bold" />

            <!-- Кнопки изменения температуры: 2 из 3 обязательных -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/buttonCool"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Охладить" />

                <Button
                    android:id="@+id/buttonHeat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Обогреть" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===================== CARDVIEW: РЕЖИМЫ ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardModes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/cardTemperature"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Режимы работы"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Второй Switch -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchSleepMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Режим сна"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textViewStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Статус: работает на охлаждение"
                android:textColor="#6B7280"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===================== НИЖНЯЯ КНОПКА «ВЫКЛЮЧИТЬ» ===================== -->
    <Button
        android:id="@+id/buttonPowerOff"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Выключить кондиционер"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/cardModes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
