class Employee(
    val lastName: String,
    val firstName: String,
    val middleName: String,
    val position: String,
    val email: String,
    val phone: String,
    val salary: Int,
    val age: Int 
) {
    // Вторичный конструктор для сотрудников на испытательном сроке (без зарплаты)
    constructor(
        lastName: String,
        firstName: String,
        middleName: String,
        position: String,
        email: String,
        phone: String,
        age: Int
    ) : this(lastName, firstName, middleName, position, email, phone, salary = 0, age)

    // Метод для красивого вывода информации о сотруднике
    fun printInfo() {
        println("ФИО: $lastName $firstName $middleName")
        println("Должность: $position")
        println("Email: $email")
        println("Телефон: $phone")
        if (salary > 0) {
            println("Зарплата: $salary руб.")
        } else {
            println("Зарплата: испытательный срок (без зарплаты)")
        }
        println("Возраст: $age лет")
        println("-----------------------------")
    }
}

fun main() {
    // Создаём массив из пяти сотрудников
    val employees = arrayOf(
        Employee("Петров", "Алексей", "Иванович", "Менеджер",
            "petrov@example.ru", "+7 (999) 123-45-67", 60000, 35),
        Employee("Сидорова", "Мария", "Сергеевна", "Бухгалтер",
            "sidorova@example.ru", "+7 (999) 234-56-78", 55000, 42),
        Employee("Иванов", "Дмитрий", "Петрович", "Программист",
            "ivanov@example.ru", "+7 (999) 345-67-89", 90000, 28),
        Employee("Козлов", "Андрей", "Николаевич", "Директор",
            "kozlov@example.ru", "+7 (999) 456-78-90", 150000, 51),
        Employee("Новиков", "Олег", "Викторович", "Стажёр",
            "novikov@example.ru", "+7 (999) 567-89-01", 45)
    )

    // Выводим информацию только о сотрудниках старше 40 лет
    println("Сотрудники старше 40 лет:")
    println("=============================")
    for (employee in employees) {
        if (employee.age > 40) {
            employee.printInfo()
        }
    }
}
